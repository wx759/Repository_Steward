# Supported providers: zhipu, bailian, deepseek, openai
LLM_PROVIDER=zhipu
LLM_MODEL=glm-5
LLM_API_KEY=
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/

# Provider-specific aliases are also supported:
# ZHIPU_API_KEY=your_key
# BAILIAN_API_KEY=your_key
# DEEPSEEK_API_KEY=your_key
# OPENAI_API_KEY=your_key

# Optional context compaction settings
CONTEXT_MAX_TOKENS=50000
CONTEXT_TOKEN_RESERVE=8000
CONTEXT_MAX_MESSAGES=50
CONTEXT_KEEP_HEAD_MESSAGES=3
CONTEXT_KEEP_RECENT_TOOL_RESULTS=3
CONTEXT_TOOL_RESULTS_BUDGET_BYTES=200000
CONTEXT_PREVIEW_CHARS=2000
CONTEXT_SUMMARY_MAX_TOKENS=2000
