# Supported providers: zhipu, bailian, deepseek, openai
LLM_PROVIDER=zhipu
LLM_MODEL=glm-5
LLM_API_KEY=
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/

# Local root containing repositories that may be selected as workspaces.
# In Docker this should be /workspaces.
WORKSPACE_ROOT=
# Docker example: DEFAULT_WORKSPACE_RELATIVE_PATH=codeAgent
DEFAULT_WORKSPACE_RELATIVE_PATH=

# Provider-specific aliases are also supported:
# ZHIPU_API_KEY=your_key
# BAILIAN_API_KEY=your_key
# DEEPSEEK_API_KEY=your_key
# OPENAI_API_KEY=your_key

# Optional context compaction settings
CONTEXT_MAX_TOKENS=50000
CONTEXT_TOKEN_RESERVE=8000
CONTEXT_MAX_MESSAGES=50
CONTEXT_KEEP_HEAD_MESSAGES=3
CONTEXT_KEEP_RECENT_TOOL_RESULTS=3
CONTEXT_TOOL_RESULTS_BUDGET_BYTES=200000
CONTEXT_PREVIEW_CHARS=2000
CONTEXT_SUMMARY_MAX_TOKENS=2000

# Optional model error recovery settings
RECOVERY_MAX_RETRIES=3
RECOVERY_INITIAL_DELAY_MS=500
RECOVERY_MAX_DELAY_MS=8000
RECOVERY_MAX_CONTINUATIONS=3
RECOVERY_DEFAULT_MAX_OUTPUT_TOKENS=8192
RECOVERY_ESCALATED_MAX_OUTPUT_TOKENS=65536
# Optional fallback model on the same provider/base URL. Empty disables fallback.
LLM_FALLBACK_MODEL=

# Optional cross-session long-term memory
MEMORY_ENABLED=true
MEMORY_SELECTOR_MAX_ITEMS=5
MEMORY_SIDE_CALL_TIMEOUT_SECONDS=20
MEMORY_EXTRACT_INPUT_CHARS=12000
MEMORY_EXTRACT_MAX_ITEMS=3
